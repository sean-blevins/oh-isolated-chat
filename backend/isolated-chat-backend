#!/usr/bin/env python3
"""oh-isolated-chat backend: promote conversation memory into the durable host store.

Runs as a host process owned by the Agent Server (Canvas App managed backend).
It never runs inside a conversation container: its job is the host-side half of
memory that an isolated conversation cannot do itself.

Two tiers, both keyed to paths the SDK's own `load_memory` already reads:

  global (user tier)   <runtime>/persistence/memory/MEMORY.md
                    -> <persistence>/memory/MEMORY.md
  project/agent profile <runtime>/workspace/.openhands/memory/MEMORY.md
                    -> <persistence>/memory/agents/<profile-key>/MEMORY.md

Promotion is a line union: the durable file keeps its order and every incoming
line it does not already have is appended. Promotions only ever add lines, so
running one is idempotent and safe to repeat.

The page also asks the host page — over postMessage, the only path from here to
the Agent Server — for the LLM profiles a fork can run on, and for the fork
itself.

Stdlib only, single file, no imports outside the standard library.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse


GLOBAL_REL = Path("persistence") / "memory" / "MEMORY.md"
PROJECT_REL = Path("workspace") / ".openhands" / "memory" / "MEMORY.md"
DURABLE_GLOBAL_REL = Path("memory") / "MEMORY.md"
DURABLE_PROFILE_DIR = Path("memory") / "agents"
CONVERSATION_META_REL = Path("agent-canvas") / "dev_conversations"
AGENT_PROFILES_REL = Path("agent-profiles")
SETTINGS_REL = Path("settings.json")
_HEX_RE = re.compile(r"^[0-9a-f]{16,64}$")
_TITLE_MAX = 80
# Canvas's seeded baseline agent profile. A local OpenHands conversation started
# on it launches from global agent_settings instead of a profile launch, so no
# launched profile is recorded for the conversation.
WELL_KNOWN_DEFAULT_PROFILE_NAME = "default"

# Tag keys Canvas hides on its own conversation cards: telemetry attribution,
# machine stamps and metadata the UI already shows somewhere else. Mirrors the
# frontend's RESERVED_CONVERSATION_TAG_KEYS, which a Canvas App cannot import.
RESERVED_TAG_KEYS = frozenset(
    {
        "acpserver",
        "clientsource",
        "automationtrigger",
        "automationid",
        "automationname",
        "automationrunid",
        "automationdraftid",
        "automationmaterializeddraftid",
        "automationeditid",
        "plannerparent",
        "title",
        "git_provider",
        "repo_name",
        "repo",
        "repository",
        "selected_branch",
        "branch",
        "archiveworkspacepath",
        "workspace",
        "working_dir",
    }
)
# Shown before the rest, matching the frontend's PRIORITY_CONVERSATION_TAG_KEYS.
PRIORITY_TAG_KEYS = ("automationsetup", "origin")


# --------------------------------------------------------------------------- #
# paths
# --------------------------------------------------------------------------- #
def find_persistence_root(data_dir: Path) -> Path:
    """Locate the host persistence root that holds runtime-data/.

    The managed backend is handed its own data dir
    (<persistence>/canvas-extensions/backends/data/<name>), so the root is a
    known number of parents up. Prefer an ancestor that actually looks like the
    persistence root, then fall back to the positional guess.
    """
    candidate = data_dir.resolve()
    for parent in candidate.parents:
        if (parent / "runtime-data").is_dir() or (parent / SETTINGS_REL).is_file():
            return parent
    if len(candidate.parents) > 3:
        return candidate.parents[3]
    raise SystemExit(f"cannot locate persistence root from data dir {data_dir}")


def runtime_dir(root: Path, hex_id: str) -> Path:
    return root / "runtime-data" / hex_id


def conversation_ids(root: Path) -> list[str]:
    data = root / "runtime-data"
    if not data.is_dir():
        return []
    ids = []
    for entry in sorted(data.iterdir()):
        if entry.is_dir() and _HEX_RE.match(entry.name):
            ids.append(entry.name)
    return ids


def read_conversation_record(root: Path, hex_id: str) -> dict:
    """The conversation's stored start record, or {} when it is unreadable."""
    path = root / CONVERSATION_META_REL / hex_id / "meta.json"
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def conversation_title(record: dict) -> str:
    """The name Canvas shows for this conversation.

    Titles are auto-generated, so fall back to the opening message for a
    conversation that has not been titled yet -- an untitled row is useless in
    a list you are picking a memory source from.
    """
    title = record.get("title")
    if isinstance(title, str) and title.strip():
        return title.strip()
    message = record.get("initial_message")
    content = message.get("content") if isinstance(message, dict) else None
    if isinstance(content, list):
        for part in content:
            text = part.get("text") if isinstance(part, dict) else None
            if isinstance(text, str) and text.strip():
                first = text.strip().splitlines()[0].strip()
                return first[:_TITLE_MAX] + ("…" if len(first) > _TITLE_MAX else "")
    return "Untitled"


def display_tags(record: dict) -> list[list[str]]:
    """User-facing tags, as ordered ``[key, value]`` pairs.

    Mirrors Canvas's rule: reserved keys stay out, bare tags (an empty value)
    are shown by key alone, and ordering is stable so chips do not shuffle.
    """
    tags = record.get("tags")
    if not isinstance(tags, dict):
        return []

    def rank(key: str) -> int:
        try:
            return PRIORITY_TAG_KEYS.index(key)
        except ValueError:
            return len(PRIORITY_TAG_KEYS)

    entries = [
        (str(key).strip(), value)
        for key, value in tags.items()
        if str(key).strip().lower() not in RESERVED_TAG_KEYS
        and isinstance(value, str)
        and (value == "" or value.strip())
    ]
    entries.sort(key=lambda entry: (rank(entry[0].lower()), entry[0].lower()))
    return [[key, value] for key, value in entries]


def read_agent_profiles(root: Path) -> list[dict[str, str]]:
    """Every agent profile on disk, as ``{id, name, file}``."""
    profiles: list[dict[str, str]] = []
    directory = root / AGENT_PROFILES_REL
    if not directory.is_dir():
        return profiles
    for entry in sorted(directory.glob("*.json")):
        try:
            data = json.loads(entry.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(data, dict):
            continue
        profile_id = data.get("id")
        if not isinstance(profile_id, str) or not profile_id:
            continue
        name = data.get("name")
        profiles.append(
            {
                "id": profile_id,
                "name": (
                    name.strip()
                    if isinstance(name, str) and name.strip()
                    else entry.stem
                ),
                "file": entry.stem,
            }
        )
    return profiles


def profile_names(root: Path) -> dict[str, str]:
    """Map agent profile id -> name, so the store is labelled in human terms."""
    return {profile["id"]: profile["name"] for profile in read_agent_profiles(root)}


def default_profile_id(root: Path) -> str:
    """The id of the seeded baseline profile, or "" when there is none."""
    profiles = read_agent_profiles(root)
    for profile in profiles:
        if profile["name"] == WELL_KNOWN_DEFAULT_PROFILE_NAME:
            return profile["id"]
    for profile in profiles:
        if profile["file"] == WELL_KNOWN_DEFAULT_PROFILE_NAME:
            return profile["id"]
    return ""


def profile_key(
    root: Path, hex_id: str, record: dict | None = None
) -> tuple[str, str]:
    """Resolve the durable key for a conversation's project/agent-profile tier.

    Returns (key, source), where source is one of:

      launched    the profile this conversation was started with, frozen in the
                  Canvas record.
      default     nothing recorded, which for a local OpenHands launch means the
                  conversation ran on the seeded `default` profile through global
                  agent_settings. That profile's folder owns its memory.
      unresolved  nothing recorded and no default profile on disk, so the
                  literal "default" key is the only remaining answer.
    """
    if record is None:
        record = read_conversation_record(root, hex_id)
    launched = record.get("launched_agent_profile") or {}
    profile_id = launched.get("agent_profile_id") if isinstance(launched, dict) else None
    if profile_id:
        return str(profile_id), "launched"
    default_id = default_profile_id(root)
    if default_id:
        return default_id, "default"
    return WELL_KNOWN_DEFAULT_PROFILE_NAME, "unresolved"


def memory_paths(root: Path, hex_id: str) -> dict[str, tuple[Path, Path, str]]:
    """Map tier -> (conversation file, durable file, key)."""
    key, _ = profile_key(root, hex_id)
    runtime = runtime_dir(root, hex_id)
    return {
        "global": (runtime / GLOBAL_REL, root / DURABLE_GLOBAL_REL, "global"),
        "profile": (
            runtime / PROJECT_REL,
            root / DURABLE_PROFILE_DIR / key / "MEMORY.md",
            key,
        ),
    }


# --------------------------------------------------------------------------- #
# union
# --------------------------------------------------------------------------- #
def union_text(existing: str, incoming: str) -> tuple[str, list[str]]:
    """Append lines from incoming that existing does not already carry.

    Line order is preserved on both sides and the incoming file is never
    rewritten. Comparison ignores surrounding whitespace so cosmetic edits do
    not duplicate a line, and blank lines are never appended.
    """
    known = {line.strip() for line in existing.splitlines() if line.strip()}
    added: list[str] = []
    for line in incoming.splitlines():
        stripped = line.strip()
        if not stripped or stripped in known:
            continue
        known.add(stripped)
        added.append(line.rstrip())
    if not added:
        return existing, []
    base = existing
    if base and not base.endswith("\n"):
        base += "\n"
    return base + "\n".join(added) + "\n", added


def read_text(path: Path) -> str:
    try:
        return path.read_text()
    except FileNotFoundError:
        return ""
    except OSError as exc:
        raise SystemExit(f"cannot read {path}: {exc}") from exc


def pending_lines(source: Path, dest: Path) -> list[str]:
    _, added = union_text(read_text(dest), read_text(source))
    return added


def promote_tier(source: Path, dest: Path) -> dict[str, object]:
    if not source.is_file():
        return {"tier": None, "present": False, "added": []}
    incoming = read_text(source)
    existing = read_text(dest)
    merged, added = union_text(existing, incoming)
    if added:
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(merged)
    return {"present": True, "added": added, "dest": str(dest)}


def promote(root: Path, hex_id: str) -> dict[str, object]:
    tiers = memory_paths(root, hex_id)
    result: dict[str, object] = {"conversation": hex_id, "tiers": {}}
    key, source = profile_key(root, hex_id)
    result["profile_key"] = key
    result["profile_key_source"] = source
    result["profile_name"] = profile_names(root).get(key, "")
    for tier, (src, dest, _) in tiers.items():
        outcome = promote_tier(src, dest)
        outcome["tier"] = tier
        result["tiers"][tier] = outcome
    return result


# --------------------------------------------------------------------------- #
# state
# --------------------------------------------------------------------------- #
def conversation_state(root: Path) -> list[dict[str, object]]:
    names = profile_names(root)
    rows = []
    for hex_id in conversation_ids(root):
        record = read_conversation_record(root, hex_id)
        key, key_source = profile_key(root, hex_id, record)
        tiers = {}
        for tier, (src, dest, _) in memory_paths(root, hex_id).items():
            exists = src.is_file()
            tiers[tier] = {
                "source": str(src),
                "dest": str(dest),
                "exists": exists,
                "lines": len(read_text(src).splitlines()) if exists else 0,
                "pending": len(pending_lines(src, dest)) if exists else 0,
                "modified": (
                    time.strftime("%Y-%m-%d %H:%M", time.localtime(src.stat().st_mtime))
                    if exists
                    else None
                ),
            }
        rows.append(
            {
                "id": hex_id,
                "title": conversation_title(record),
                "tags": display_tags(record),
                "profile_key": key,
                "profile_key_source": key_source,
                "profile_name": names.get(key, ""),
                "tiers": tiers,
            }
        )
    return rows


def durable_files(root: Path) -> list[Path]:
    """Every memory file in the durable store, global tier first."""
    files = [root / DURABLE_GLOBAL_REL]
    agents = root / DURABLE_PROFILE_DIR
    if agents.is_dir():
        files.extend(
            entry / "MEMORY.md" for entry in sorted(agents.iterdir()) if entry.is_dir()
        )
    return [path for path in files if path.is_file()]


def clear_durable(root: Path) -> list[str]:
    """Delete every durable memory file, returning the paths removed.

    Debug-only: the durable store is what new conversations are seeded from, so
    clearing it is how you get back to a conversation that starts with no memory.
    A conversation keeps its own copy of what it promoted, so promoting again
    restores the lines it still carries.
    """
    removed = []
    for path in durable_files(root):
        path.unlink()
        removed.append(str(path))
    # A profile's directory only exists to hold its memory file; leaving empty
    # ones behind would keep reporting a profile the store no longer knows.
    agents = root / DURABLE_PROFILE_DIR
    if agents.is_dir():
        for entry in agents.iterdir():
            if entry.is_dir() and not any(entry.iterdir()):
                entry.rmdir()
    return removed


def durable_state(root: Path) -> list[dict[str, object]]:
    names = profile_names(root)
    files = []
    for path in durable_files(root):
        key = "global" if path == root / DURABLE_GLOBAL_REL else path.parent.name
        files.append(
            {
                "path": str(path),
                "key": key,
                "name": (
                    "global (every profile)"
                    if key == "global"
                    else names.get(key, "unknown profile")
                ),
                "text": path.read_text(),
            }
        )
    return files


def state(root: Path) -> dict[str, object]:
    return {
        "persistence_root": str(root),
        "conversations": conversation_state(root),
        "durable": durable_state(root),
    }


# --------------------------------------------------------------------------- #
# http
# --------------------------------------------------------------------------- #
class Handler(BaseHTTPRequestHandler):
    server_version = "oh-isolated-chat/0.1"
    root: Path

    def log_message(self, fmt: str, *args: object) -> None:
        sys.stderr.write("[oh-isolated-chat] %s\n" % (fmt % args))

    def _send(self, status: int, body: bytes, content_type: str) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, status: int, payload: object) -> None:
        body = json.dumps(payload, indent=2).encode()
        self._send(status, body, "application/json")

    def do_GET(self) -> None:  # noqa: N802 - BaseHTTPRequestHandler API
        route = urlparse(self.path).path
        if route == "/health":
            return self._json(200, {"status": "ok"})
        if route == "/api/state":
            return self._json(200, state(self.root))
        if route in {"/", "/index.html"}:
            return self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        return self._json(404, {"error": "not found"})

    def do_POST(self) -> None:  # noqa: N802 - BaseHTTPRequestHandler API
        route = urlparse(self.path).path
        if route == "/api/clear":
            return self._json(
                200, {"cleared": clear_durable(self.root), "state": state(self.root)}
            )
        if route != "/api/promote":
            return self._json(404, {"error": "not found"})
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length) if length else b"{}"
        try:
            payload = json.loads(raw or b"{}")
        except ValueError:
            return self._json(400, {"error": "invalid JSON body"})
        target = str(payload.get("conversation") or "all")
        known = conversation_ids(self.root)
        if target == "all":
            results = [promote(self.root, hex_id) for hex_id in known]
        elif target in known:
            results = [promote(self.root, target)]
        else:
            return self._json(404, {"error": f"unknown conversation {target!r}"})
        return self._json(200, {"promoted": results, "state": state(self.root)})


